<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 画廊动图「仅 Wi-Fi」那一档要问"这条网络计不计费"（GalleryConnectivity）。普通权限，不弹运行时窗。 -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Android 13+ 下载进度通知运行时权限 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!--
        把漫画库放进用户自选的公共目录（含外置卡）需要它：分区存储下 java.io.File
        写不了公共目录，而下载/续下/扫描/CBZ 整条链都是 File 语义。
        应用不默认持有该权限，只在用户选完目录、探针实测写不进时才引导去系统页开。
    -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />

    <application
        android:name=".VeneraApp"
        android:allowBackup="true"
        android:enableOnBackInvokedCallback="true"
        android:label="venera-miuix"
        android:supportsRtl="true"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/Theme.Venera">
        <!--
            应用链接（App Links）：一个源一个 intent-filter，让系统的「打开支持的链接」
            清单按站点分组，用户可逐域开关。
            ⚠️ 刻意**不写 android:autoVerify**：验证要求域名的所有者在
            https://<host>/.well-known/assetlinks.json 发布本 app 的签名指纹，而下面这些站
            都不是我们的域名 —— 写了只会得到一个永远失败的验证状态，直达能力一条不加。
            master 同样一条没写。未验证域由用户在系统设置里手动关联，链接照样能跳进来。
            host 清单必须与 ComicUrlTable.appLinkScopes 逐条对齐（有单测把 XML 和表对着读）。
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.Venera">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- 拷贝漫画 -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="copymanga.tv" android:pathPrefix="/comic" />
                <data android:host="www.copymanga.tv" android:pathPrefix="/comic" />
                <data android:host="copymanga.site" android:pathPrefix="/comic" />
                <data android:host="www.copymanga.site" android:pathPrefix="/comic" />
                <data android:host="mangacopy.com" android:pathPrefix="/comic" />
                <data android:host="www.mangacopy.com" android:pathPrefix="/comic" />
            </intent-filter>

            <!-- 包子漫画 -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="baozimh.com" android:pathPrefix="/comic" />
                <data android:host="www.baozimh.com" android:pathPrefix="/comic" />
                <data android:host="cn.baozimh.com" android:pathPrefix="/comic" />
            </intent-filter>

            <!-- MangaDex -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="mangadex.org" android:pathPrefix="/title" />
                <data android:host="www.mangadex.org" android:pathPrefix="/title" />
            </intent-filter>

            <!-- 哔哩哔哩漫画 -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="manga.bilibili.com" android:pathPrefix="/detail" />
            </intent-filter>

            <!-- 禁漫天堂：站内 album 与 photo 两种本子路径都要认（master 只声明了 /g 一档） -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="18comic.vip" android:pathPrefix="/album" />
                <data android:host="18comic.vip" android:pathPrefix="/photo" />
                <data android:host="www.18comic.vip" android:pathPrefix="/album" />
                <data android:host="www.18comic.vip" android:pathPrefix="/photo" />
                <data android:host="18comic.org" android:pathPrefix="/album" />
                <data android:host="18comic.org" android:pathPrefix="/photo" />
                <data android:host="www.18comic.org" android:pathPrefix="/album" />
                <data android:host="www.18comic.org" android:pathPrefix="/photo" />
                <data android:host="jmcomic.me" android:pathPrefix="/album" />
                <data android:host="jmcomic.me" android:pathPrefix="/photo" />
                <data android:host="www.jmcomic.me" android:pathPrefix="/album" />
                <data android:host="www.jmcomic.me" android:pathPrefix="/photo" />
            </intent-filter>

            <!-- E-Hentai / ExHentai -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="e-hentai.org" android:pathPrefix="/g" />
                <data android:host="exhentai.org" android:pathPrefix="/g" />
            </intent-filter>

            <!-- nhentai -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="nhentai.net" android:pathPrefix="/g" />
                <data android:host="www.nhentai.net" android:pathPrefix="/g" />
            </intent-filter>

            <!-- 绅士漫画 wnacg -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="wnacg.com" android:pathPrefix="/photos-" />
                <data android:host="www.wnacg.com" android:pathPrefix="/photos-" />
                <data android:host="wnacg.org" android:pathPrefix="/photos-" />
            </intent-filter>

            <!-- Hitomi -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="hitomi.la" android:pathPrefix="/reader" />
                <data android:host="hitomi.la" android:pathPrefix="/galleries" />
                <data android:host="www.hitomi.la" android:pathPrefix="/reader" />
                <data android:host="www.hitomi.la" android:pathPrefix="/galleries" />
            </intent-filter>

            <!-- 哔咔 PicaWeb：单本详情是 /comic/<24位hex>（单数；/comics/* 全是列表页）。
                 pathPrefix 带尾斜杠，才不会把 /comics/creator/... 那种列表页也吸进来。 -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="manhuabika.com" android:pathPrefix="/comic/" />
                <data android:host="www.manhuabika.com" android:pathPrefix="/comic/" />
            </intent-filter>

            <!-- 别的 app 分享纯文本给 Venera → 直接进搜索（master 的 handle_text_share 口径） -->
            <intent-filter android:label="搜索">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>
        <!--
            设置子树独立成 Activity：只有跨过 Activity 边界，系统才会施加 AOSP
            跨 activity 预测式返回动画；返回模糊走该窗口的 blur-behind。
        -->
        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Material.NoActionBar" />
        <!--
            设置二级页统一宿主：8 个页面共用一个类，靠 extra 分发。
            每页真的换一个 Activity，系统才会施加 AOSP 跨 activity 预测式返回动画。
        -->
        <activity
            android:name=".SettingsSubActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Material.NoActionBar" />
        <!--
            画廊大图页：独立 Activity 才有系统跨 activity 预测式返回，
            也只有窗口真的透（Translucent + 透明窗口底）才露得出 blur-behind 糊好的那一屏。
            用 Material.NoActionBar 的话会被基类那层氛围底盖成不透明，等于白挂。
            主题用本仓库自己那一份（`res/values/themes.xml`）而不是平台的
            `Theme.Translucent.NoTitleBar`：后者不画系统栏底，状态栏那一条会被系统压成黑带，
            糊好的背景就只到状态栏下沿为止（四条理由写在那份注释里）。
        -->
        <activity
            android:name=".GalleryPostActivity"
            android:exported="false"
            android:theme="@style/Theme.Venera.GlassOverlay" />
        <!--
            画廊画师介绍页（批次 Q+R）：与大图页同一承载 —— 只有独立 Activity 才透得出
            blur-behind，而那正是这一页的底。栈是 Main → Post → Profile，
            "看 TA 全部作品"那一级由 Post 收结果后一起 finish（见 GalleryArtistProfileActivity 头注）。
        -->
        <activity
            android:name=".GalleryArtistProfileActivity"
            android:exported="false"
            android:theme="@style/Theme.Venera.GlassOverlay" />
        <activity
            android:name=".data.network.CloudflareBypassActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Material.NoActionBar" />

        <!-- 阅读器分享当前页图片：cacheDir/shared_images 经此 Provider 授权外部读取 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
