<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Android 13+ 下载进度通知运行时权限 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".VeneraApp"
        android:allowBackup="true"
        android:enableOnBackInvokedCallback="true"
        android:label="Venera Compose"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.NoActionBar">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Material.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!--
            设置子树独立成 Activity：只有跨过 Activity 边界，系统才会施加 AOSP
            跨 activity 预测式返回动画；返回模糊走该窗口的 blur-behind。
        -->
        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Material.NoActionBar" />
        <!--
            设置二级页统一宿主：8 个页面共用一个类，靠 extra 分发。
            每页真的换一个 Activity，系统才会施加 AOSP 跨 activity 预测式返回动画。
        -->
        <activity
            android:name=".SettingsSubActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Material.NoActionBar" />
        <activity
            android:name=".data.network.CloudflareBypassActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Material.NoActionBar" />

        <!-- 阅读器分享当前页图片：cacheDir/shared_images 经此 Provider 授权外部读取 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
